// Manifest and version information of the build window (few-build-ui.exe).
#include <winver.h>

1 24 "few_build_ui.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FEW Recomp project"
            VALUE "FileDescription", "Fire Emblem Warriors Recomp build window"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "few-build-ui"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "few-build-ui.exe"
            VALUE "ProductName", "FEW Recomp"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
