{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Fire Emblem Warriors Recomp",
  "start": {
    "program": ["Jogar no PC/few.exe", "FireEmblemWarriors/few-steam.sh"]
  },
  "saves": ["{install}/Jogar no PC/save", "{install}/FireEmblemWarriors/save"],
